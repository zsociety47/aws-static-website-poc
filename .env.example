# Copy this file to .env and fill it in. .env is gitignored.
# The scripts read this file. They do not fall back to the default AWS profile.
#
# Sign in with: aws login --profile staticweb --region us-east-1
# That opens a browser. It does not store a long-lived access key in this repo.

AWS_PROFILE=staticweb
AWS_REGION=us-east-1
BUCKET_NAME=staticweb-poc-zeon01

# Leave DOMAIN_NAME empty until you buy a domain and the hosted zone already exists.
# The first deploy stops at the CloudFront hostname. Do not put www. in front.
DOMAIN_NAME=
